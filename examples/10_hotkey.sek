# Пример хоткеев.
# После запуска файл не завершится сразу.
# Он зарегистрирует хоткеи и будет ждать нажатий.
# Что здесь настроено:
# 1. x  -> показать окно и отправить "hello" + Enter
# 2. F1 -> вывести текст в консоль, подождать и показать окно
# Такой файл полезен как база для макросов и автодействий.

print "hotkeys loaded"

x::
msg "X pressed"
send "hello"{Enter}

f1::
print "F1 pressed"
sleep 100
msg "F1 trigger"
