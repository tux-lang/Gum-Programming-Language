# Пример if / elif / else.
# Сначала создаётся случайное число x.
# Потом язык проверяет условия сверху вниз:
# 1. если x > 7, будет "big"
# 2. иначе если x > 3, будет "mid"
# 3. иначе будет "small"
# Это хороший минимальный пример условных веток.

let x = random(10)
print "x = " + x

if x > 7
print "big"
elif x > 3
print "mid"
else
print "small"
end
