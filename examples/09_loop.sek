# Пример loop и unloop.
# В Gum есть несколько вариантов цикла:
# 1. loop 5        -> повторить блок 5 раз
# 2. loop          -> повторять блок бесконечно до остановки скрипта
# 3. loop {3}      -> цикл с номером 3
# 4. unloop {3}    -> остановить цикл с номером 3
#
# unloop полезен, когда у цикла есть номер.
# Тогда внутри кода можно сказать:
# "останови именно loop {3}".
# Это удобно, если в файле несколько разных циклов.
#
# Ниже оставлен безопасный пример с фиксированным числом повторов.

loop 5
print random(100)
sleep 100
end

# Шаблон для бесконечного цикла:
#
# loop
# click
# sleep 10
# end
#
# Шаблон для нумерованного цикла и unloop:
#
# let count = 0
#
# loop {3}
# print "tick " + count
# count = count + 1
#
# if count == 5
#     unloop {3}
# end
#
# sleep 100
# end
#
# Здесь unloop {3} останавливает именно loop {3},
# когда переменная count доходит до 5.
